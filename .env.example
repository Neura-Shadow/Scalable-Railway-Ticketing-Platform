APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://railway:railway-local@postgres:5432/railway?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
DATABASE_TIMEOUT=3s
REDIS_TIMEOUT=1s
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=scalable-railway-ticketing-platform
JWT_AUDIENCE=railway-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
RESERVATION_HOLD_TTL_SECONDS=600
RESERVATION_MAX_PASSENGERS=6
RESERVATION_MAX_ACTIVE_HOLDS_PER_USER=10
RESERVATION_MAX_ACTIVE_HOLDS_PER_USER_PER_TRAIN_RUN=3
RESERVATION_MAX_ACTIVE_PASSENGERS_PER_USER=24
RESERVATION_MAX_INFLIGHT_PER_INSTANCE=32
# Inject key-id=base64url entries whose decoded key material is exactly 32 bytes.
# API and admission workers share the accept set; rotate API accept keys before worker issuance.
ADMISSION_TOKEN_KEYRING=
ADMISSION_TOKEN_ISSUE_KEY_ID=
ADMISSION_TOKEN_ACCEPT_KEY_IDS=
ADMISSION_WORKER_ENABLED=false
ADMISSION_WORKER_BATCH_SIZE=100
ADMISSION_WORKER_INTERVAL_MILLISECONDS=250
HOLD_EXPIRER_ENABLED=false
HOLD_EXPIRER_BATCH_SIZE=50
HOLD_EXPIRER_INTERVAL_SECONDS=30
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER=log
# Production log publishing is rejected unless this emergency-only override is explicit.
ALLOW_LOG_PUBLISHER_IN_PRODUCTION=false
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_PROCESSING_TIMEOUT_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=60
WORKER_HTTP_ADDRESS=:9090
WORKER_PASS_TIMEOUT=60s
READ_MODEL_WORKER_ENABLED=false
READ_MODEL_WORKER_BATCH_SIZE=100
READ_MODEL_WORKER_INTERVAL_MILLISECONDS=1000
READ_MODEL_CONSUMER_GROUP=railway-read-model
# Leave empty to generate a unique process-local name; set a unique pod/replica name in production.
READ_MODEL_CONSUMER_NAME=
READ_MODEL_MAX_ATTEMPTS=5
# Must be greater than WORKER_PASS_TIMEOUT.
READ_MODEL_CLAIM_MIN_IDLE_SECONDS=90
STATION_CACHE_ENABLED=true
STATION_CACHE_TTL_SECONDS=300
STATION_CACHE_JITTER_SECONDS=30
TRAIN_SEARCH_CACHE_ENABLED=true
TRAIN_SEARCH_CACHE_TTL_SECONDS=60
TRAIN_SEARCH_CACHE_JITTER_SECONDS=10
TRAIN_SEARCH_FALLBACK_ENABLED=true
AVAILABILITY_CACHE_ENABLED=true
AVAILABILITY_CACHE_TTL_SECONDS=10
AVAILABILITY_CACHE_JITTER_SECONDS=2
AVAILABILITY_CACHE_MAX_STALE_SECONDS=10
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
